{
  "name": "dt-duet",
  "displayName": "DT Duet — AI Pair Programming",
  "description": "Claude writes, Gemini reviews — run and watch the duet from VS Code.",
  "version": "0.2.7",
  "publisher": "harsha509",
  "license": "MIT",
  "icon": "media/logo.png",
  "keywords": [
    "ai",
    "pair programming",
    "code review",
    "claude",
    "gemini"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/harsha509/duetcode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dtDuet",
          "title": "DT Duet",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dtDuet": [
        {
          "id": "dtSessions",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "dt.newTask",
        "title": "DT: New Task",
        "icon": "$(add)"
      },
      {
        "command": "dt.stopTask",
        "title": "DT: Stop Running Task",
        "icon": "$(debug-stop)"
      },
      {
        "command": "dt.refreshSessions",
        "title": "DT: Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "dt.openSession",
        "title": "DT: Open Session"
      },
      {
        "command": "dt.settings",
        "title": "DT: Settings (API keys, Claude login)",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dt.stopTask",
          "when": "view == dtSessions && dt.running",
          "group": "navigation@0"
        },
        {
          "command": "dt.newTask",
          "when": "view == dtSessions",
          "group": "navigation@1"
        },
        {
          "command": "dt.refreshSessions",
          "when": "view == dtSessions",
          "group": "navigation@2"
        },
        {
          "command": "dt.settings",
          "when": "view == dtSessions",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "DT Duet",
      "properties": {
        "dt.binaryPath": {
          "type": "string",
          "default": "dt",
          "scope": "machine",
          "description": "Path to the dt binary. Machine-scoped so workspace settings cannot point it at an untrusted binary."
        },
        "dt.writer": {
          "type": "string",
          "enum": [
            "claude",
            "gemini"
          ],
          "default": "claude",
          "description": "Which model writes code (the other reviews)."
        },
        "dt.claudeModel": {
          "type": "string",
          "default": "",
          "description": "Claude model version, e.g. \"sonnet\", \"opus\", or a full id like \"claude-opus-4-8\". Empty uses .duet/config.toml (default: sonnet). Use a full model id if you rely on Claude API mode."
        },
        "dt.geminiModel": {
          "type": "string",
          "default": "",
          "description": "Gemini model version, e.g. \"gemini-3.1-pro-preview\" or \"gemini-2.5-flash\". Empty uses .duet/config.toml."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
